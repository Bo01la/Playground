{
  "trailingComma": "none",
  "semi": true,
  "plugins": [
    "prettier-plugin-apex",
    "@prettier/plugin-xml",
    "prettier-plugin-tailwindcss"
  ],
  "overrides": [
    {
      "files": "**/lwc/**/*.html",
      "options": { "parser": "lwc" }
    },
    {
      "files": "*.{cmp,page,component}",
      "options": { "parser": "html" }
    },
    {
      "files": "*.{jsx,tsx}",
      "options": { "parser": "babel" }
    },
    {
      "files": "*.css",
      "options": { "parser": "css" }
    },
    {
      "files": "*.json",
      "options": { "parser": "json" }
    }
  ]
}
