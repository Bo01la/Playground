<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Grants full access to Healthcare Provider, Member Policy, and Pre-Authorization Request objects and fields.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Healthcare Pre-Auth Full Access</label>

    <!-- Field Permissions: Member Policy -->
    <fieldPermissions>
        <editable>true</editable>
        <field>member_policy__c.Policy_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>member_policy__c.Policy_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>member_policy__c.Remaining_Balance__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>member_policy__c.Utilized_Limit_Yearly__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>member_policy__c.Yearly_Limit__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>member_policy__c.annual_limit__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>member_policy__c.total_consumed__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field Permissions: Provider -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Provider__c.NPI_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Provider__c.Provider_Type__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Provider__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field Permissions: Pre-Authorization Request -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Pre_Authorization_Request__c.Approved_Amount__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Pre_Authorization_Request__c.Provider__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Pre_Authorization_Request__c.Requested_Amount__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Object Permissions -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>member_policy__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Provider__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Pre_Authorization_Request__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
